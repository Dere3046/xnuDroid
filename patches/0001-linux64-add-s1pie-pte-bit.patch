+++ b/osfmk/arm/arm_init.c
@@ -232,6 +232,7 @@ extern vm_offset_t segLOWESTRXAuxKC, segHIGHESTRXAuxKC, segHIGHESTNLEAuxKC;
 /* LINUX64 (xnulinux): the hosted machine layer's state (linux64/linux64.h), set by xnu.ko before arm_init */
 uintptr_t linux64_hook;
 uintptr_t linux64_slide;
+unsigned int linux64_s1pie;
 unsigned int linux64_vint[LINUX64_CPU_SLOTS];
