diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
index 2acc959..d085730 100644
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -58,6 +58,7 @@
 #include <vm/vm_object_internal.h>
 #include <vm/vm_page_internal.h>
 #include <vm/vm_pageout.h>
+#include <linux64/linux64.h>
 #include <vm/cpm_internal.h>
 
 #include <libkern/img4/interface.h>
@@ -701,9 +702,25 @@ pte_is_xs(const pt_attr_t *pt_attr, pt_entry_t pte)
  *            in this value will automatically be incremented for each PTE
  *            write.
  */
+static inline pt_entry_t
+linux64_s1pie_pte(pt_entry_t pte)
+{
+	/* Linux S1PIE needs bit 51 set on writable leaves and clear on read only */
+	if (__improbable(linux64_s1pie) && (pte & ARM_PTE_TYPE_VALID) &&
+	    (pte & ARM_PTE_AF)) {
+		if (!(pte & ARM_PTE_AP(2))) {
+			pte |= (1ULL << 51);
+		} else {
+			pte &= ~(1ULL << 51);
+		}
+	}
+	return pte;
+}
+
 static void
 write_pte_fast(pt_entry_t *ptep, pt_entry_t pte)
 {
+	pte = linux64_s1pie_pte(pte);
 	/**
 	 * The PAGE_SHIFT (and in turn, the PAGE_RATIO) can be a variable on some
 	 * systems, which is why it's checked at runtime instead of compile time.
@@ -5971,6 +5988,8 @@ pmap_enter_pte(pmap_t pmap, pt_entry_t *pte_p, pt_entry_t *old_pte, pt_entry_t n
 	const pt_attr_t * const pt_attr = pmap_get_pt_attr(pmap);
 	bool success = false, changed_wiring = false;
 
+	new_pte = linux64_s1pie_pte(new_pte);
+
 	__unreachable_ok_push
