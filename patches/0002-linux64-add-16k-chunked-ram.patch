diff --git a/EXTERNAL_HEADERS/linux64/linux64.h b/EXTERNAL_HEADERS/linux64/linux64.h
index 549fb09..977a6c8 100644
--- a/EXTERNAL_HEADERS/linux64/linux64.h
+++ b/EXTERNAL_HEADERS/linux64/linux64.h
@@ -36,7 +36,27 @@ extern "C" {
 extern unsigned long linux64_hook;
 extern unsigned long linux64_slide;
 extern unsigned int linux64_s1pie;
+extern struct linux64_phys_map linux64_phys_map;
 
+unsigned long long linux64_hpa_to_gpa(unsigned long long hpa);
+
+static inline unsigned long long
+linux64_gpa_to_hpa(unsigned long long gpa)
+{
+	unsigned long long off;
+	unsigned long idx;
+
+	if (__builtin_expect(!linux64_phys_map.n_chunks, 1)) {
+		return gpa;
+	}
+	if (gpa < linux64_phys_map.gpa_base || gpa >= linux64_phys_map.gpa_end) {
+		return gpa;
+	}
+	off = gpa - linux64_phys_map.gpa_base;
+	idx = (unsigned long)(off >> LINUX64_CHUNK_SHIFT);
+	return ((unsigned long long)linux64_phys_map.g2h[idx] << LINUX64_CHUNK_SHIFT) |
+	       (gpa & (LINUX64_CHUNK_SIZE - 1));
+}
 /* This CPU's slot in the per-CPU arrays (LINUX64_CPU_SLOT of its MPIDR): valid before XNU knows its cpu number */
 static inline unsigned
 linux64_cpu_slot(void)
diff --git a/EXTERNAL_HEADERS/linux64/linux64_abi.h b/EXTERNAL_HEADERS/linux64/linux64_abi.h
index 66855e2..44dab90 100644
--- a/EXTERNAL_HEADERS/linux64/linux64_abi.h
+++ b/EXTERNAL_HEADERS/linux64/linux64_abi.h
@@ -25,6 +25,23 @@
 
 #define LINUX64_ABI_VERSION 3
 
+#define LINUX64_CHUNK_SHIFT 14
+#define LINUX64_CHUNK_SIZE  (1ULL << LINUX64_CHUNK_SHIFT)
+#define LINUX64_CHUNK_MASK  (~(LINUX64_CHUNK_SIZE - 1))
+
+struct linux64_h2g_slot {
+	__UINT32_TYPE__ hpa_tag;	/* shifted hpa plus one */
+	__UINT32_TYPE__ chunk_idx;
+};
+
+struct linux64_phys_map {
+	__UINT64_TYPE__ gpa_base;
+	__UINT64_TYPE__ gpa_end;
+	const __UINT32_TYPE__ *g2h;	/* shifted hpa per 16k chunk */
+	const struct linux64_h2g_slot *h2g;
+	__UINT32_TYPE__ n_chunks;
+	__UINT32_TYPE__ hash_mask;
+};
 
 enum linux64_call {
 	LINUX64_CALL_KERNEL_TABLES  = 210,	/* boot: a1 = XNU's kernel L1 table; the host installs its kernel-range entries */
diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 3887905..31bb2aa 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -233,10 +233,35 @@ extern vm_offset_t segLOWESTRXAuxKC, segHIGHESTRXAuxKC, segHIGHESTNLEAuxKC;
 uintptr_t linux64_hook;
 uintptr_t linux64_slide;
 unsigned int linux64_s1pie;
+struct linux64_phys_map linux64_phys_map;
 unsigned int linux64_vint[LINUX64_CPU_SLOTS];
 unsigned int linux64_ipi_pending[LINUX64_CPU_SLOTS];
 unsigned long linux64_dbg[LINUX64_NCOUNTERS];
 
+unsigned long long
+linux64_hpa_to_gpa(unsigned long long hpa)
+{
+	__UINT32_TYPE__ tag;
+	unsigned long h, mask;
+	const struct linux64_h2g_slot *tab;
+
+	if (!linux64_phys_map.n_chunks || !(tab = linux64_phys_map.h2g)) {
+		return hpa;
+	}
+	tag = (__UINT32_TYPE__)(hpa >> LINUX64_CHUNK_SHIFT) + 1U;
+	mask = linux64_phys_map.hash_mask;
+	h = (unsigned long)(((unsigned long long)tag * 11400714819323198485ULL) >> 32) & mask;
+	while (tab[h].hpa_tag != 0) {
+		if (tab[h].hpa_tag == tag) {
+			return (linux64_phys_map.gpa_base +
+			        ((unsigned long long)tab[h].chunk_idx << LINUX64_CHUNK_SHIFT)) |
+			       (hpa & (LINUX64_CHUNK_SIZE - 1));
+		}
+		h = (h + 1) & mask;
+	}
+	return hpa;
+}
